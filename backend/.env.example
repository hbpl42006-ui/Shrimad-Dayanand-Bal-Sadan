# ==============================================================================
# Environment Configuration Template for Shrimad Dayanand Bal Sadan Backend
# Copy this file to .env and configure with your environment-specific credentials.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Core Django Settings
DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-50-chars-min

# Allowed Hosts (comma-separated domains and IPs)
ALLOWED_HOSTS=api.shrimaddayanandbalsadan.online,130.210.22.215,127.0.0.1,localhost

# Database Configuration (PostgreSQL URL for production, or leave unset for SQLite dev)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://balsadan_user:strong_password_here@localhost:5432/balsadan_db

# CORS Allowed Origins (comma-separated origins of frontends allowed to access API)
CORS_ALLOWED_ORIGINS=https://shrimaddayanandbalsadan.online,https://www.shrimaddayanandbalsadan.online,https://shrimad-dayanand-bal-sadan.vercel.app

# CSRF Trusted Origins (comma-separated origins with scheme for CSRF protection)
CSRF_TRUSTED_ORIGINS=https://api.shrimaddayanandbalsadan.online,https://shrimaddayanandbalsadan.online,https://www.shrimaddayanandbalsadan.online

# Security & SSL Settings (Set to True in production behind HTTPS / Nginx)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS) - Optional (31536000 seconds = 1 year)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
